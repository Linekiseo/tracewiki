{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixtures.invalid/schemas/code-golden/annotation-contract-v2.schema.json",
  "title": "Code Golden v2 case annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "source_class",
    "task",
    "query",
    "query_language",
    "code_languages",
    "query_profile",
    "expected_target_keys",
    "validation_target_keys",
    "forbidden_target_keys",
    "required_path_keys",
    "expected_context_roles",
    "expected_answer_mode",
    "answerability",
    "candidate_judgments",
    "slices",
    "smoke",
    "review",
    "treatment_eligibility"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^code-golden-v2-[0-9]{3}$"
    },
    "source_class": {
      "enum": [
        "current_project_snapshot",
        "controlled_multilingual",
        "historical_error"
      ]
    },
    "task": {
      "enum": [
        "exact_location",
        "implementation",
        "call_reference_path",
        "bug_localization",
        "impact_analysis",
        "change_context",
        "historical_version",
        "test_validation"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "query_language": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "code_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "python",
          "typescript",
          "javascript",
          "json",
          "text"
        ]
      }
    },
    "query_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "ref_key",
        "acl_refs",
        "style",
        "graph_requirement"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^repo://"
        },
        "ref_key": {
          "type": "string",
          "minLength": 1
        },
        "acl_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "style": {
          "enum": [
            "natural_language",
            "identifier_heavy",
            "mixed"
          ]
        },
        "graph_requirement": {
          "enum": [
            "required",
            "optional",
            "not_required",
            "harmful_if_expanded"
          ]
        }
      }
    },
    "expected_target_keys": {
      "$ref": "#/$defs/key_list"
    },
    "validation_target_keys": {
      "$ref": "#/$defs/key_list"
    },
    "forbidden_target_keys": {
      "$ref": "#/$defs/key_list"
    },
    "required_path_keys": {
      "$ref": "#/$defs/key_list"
    },
    "expected_context_roles": {
      "$ref": "#/$defs/key_list"
    },
    "expected_answer_mode": {
      "enum": [
        "direct",
        "refuse",
        "clarify",
        "missing_evidence"
      ]
    },
    "answerability": {
      "enum": [
        "answerable",
        "unanswerable",
        "ambiguous",
        "forbidden"
      ]
    },
    "candidate_judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_key",
          "relevance_grade",
          "necessity_role",
          "note"
        ],
        "properties": {
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "relevance_grade": {
            "enum": [
              -1,
              0,
              1,
              2
            ]
          },
          "necessity_role": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "smoke": {
      "type": "boolean"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "record_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "delayed_reviewed"
          ]
        },
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "treatment_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "eligible",
            "ineligible"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ineligible"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "key_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
