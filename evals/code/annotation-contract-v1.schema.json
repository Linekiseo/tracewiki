{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-rag.local/schemas/code-golden-annotation-v1.json",
  "title": "Code Golden v1 case annotation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "dataset_version",
    "task",
    "query",
    "query_language",
    "code_languages",
    "query_profile",
    "expected_entity_ids",
    "expected_unit_ids",
    "expected_entity_types",
    "expected_locators",
    "required_paths",
    "required_edge_types",
    "expected_context_roles",
    "expected_ref",
    "expected_answer_mode",
    "answerability",
    "forbidden_entity_ids",
    "candidate_judgments",
    "slices",
    "smoke",
    "review"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^code-golden-v1-[0-9]{3}$"
    },
    "dataset_version": {
      "const": "code-golden-v1"
    },
    "task": {
      "enum": [
        "exact_location",
        "implementation",
        "call_reference_path",
        "bug_localization",
        "impact_analysis",
        "change_context",
        "historical_version",
        "test_validation"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "query_language": {
      "enum": [
        "en",
        "zh-CN",
        "mixed"
      ]
    },
    "code_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "python",
          "typescript",
          "javascript",
          "text"
        ]
      }
    },
    "query_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "repository_id",
        "scope_ref",
        "acl_refs",
        "graph_requirement"
      ],
      "properties": {
        "style": {
          "enum": [
            "natural_language",
            "identifier_heavy",
            "path",
            "stack_trace",
            "version_exact",
            "test_selector"
          ]
        },
        "repository_id": {
          "const": "repo://fixture/code-golden-shop"
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "acl_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "graph_requirement": {
          "enum": [
            "none",
            "required",
            "harmful_if_expanded"
          ]
        }
      }
    },
    "expected_entity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^unit://sha256:[0-9a-f]{64}$"
      }
    },
    "expected_entity_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "Repository",
          "Commit",
          "FileVersion",
          "CodeSymbol",
          "DiffHunk",
          "TestResult"
        ]
      }
    },
    "expected_locators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locator"
      }
    },
    "required_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "required_edge_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CALLS",
          "REFERENCES",
          "TESTS",
          "AFFECTS",
          "VALIDATED_BY",
          "FAILED_VALIDATION",
          "SAME_SYMBOL_AS",
          "RENAMED_TO",
          "MOVED_TO"
        ]
      }
    },
    "expected_context_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "target",
          "dependency",
          "caller",
          "callee",
          "test",
          "history",
          "validation",
          "version",
          "alternative",
          "warning"
        ]
      }
    },
    "expected_ref": {
      "type": "string",
      "minLength": 1
    },
    "expected_answer_mode": {
      "enum": [
        "direct",
        "refuse",
        "clarify",
        "missing_evidence"
      ]
    },
    "answerability": {
      "enum": [
        "answerable",
        "unanswerable",
        "forbidden",
        "ambiguous"
      ]
    },
    "forbidden_entity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/judgment"
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "smoke": {
      "type": "boolean"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "disagreement_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "primary_reviewed",
            "delayed_reviewed",
            "second_reviewed"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "disagreement_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "path"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "edge_type",
              "target",
              "direction"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "edge_type": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "outgoing",
                  "incoming"
                ]
              }
            }
          }
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "retrieval_unit_id",
        "relevance_grade",
        "necessity_role",
        "note"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "relevance_grade": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2
        },
        "necessity_role": {
          "enum": [
            "target",
            "dependency",
            "caller",
            "callee",
            "test",
            "history",
            "validation",
            "background",
            "forbidden",
            "harmful"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
