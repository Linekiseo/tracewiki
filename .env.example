# Runtime data. Relative paths are resolved from the process working directory.
RAG_DATA_DIR=./var
RAG_WEB_DIR=./web

# Comma-separated roots accepted by local-folder ingestion.
RAG_ALLOWED_LOCAL_ROOTS=.

# Codex session source and the default project scope used by the UI.
RAG_CODEX_HOME=~/.codex
RAG_PROJECT_ROOT=.

# Indexing limits.
RAG_MAX_FILE_BYTES=1500000
RAG_MAX_CODEX_SESSION_BYTES=50000000
RAG_MAX_CODEX_ITEM_CHARS=16000
RAG_EMBEDDING_DIMENSIONS=384

# Optional bearer token. Mutating endpoints require it when configured.
RAG_API_TOKEN=

# Required by the research-project-bridge MCP plugin. Set the same value in the
# environment that launches this service and Codex; the plugin reads it without
# storing the secret in .mcp.json.
EVIDENCE_RAG_MCP_TOKEN=

# Enforce trusted-gateway ACL refs on retrieval and evidence resolution.
# The gateway supplies comma-separated refs in X-RAG-ACL-Refs.
RAG_ENFORCE_ACL=false

# Optional OpenAI-compatible chat endpoint used by POST /v1/query.
# Without these values the endpoint returns a retrieval-only Evidence Pack.
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
