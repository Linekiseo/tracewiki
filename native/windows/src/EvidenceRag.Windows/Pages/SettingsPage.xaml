<Page x:Class="EvidenceRag.Windows.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitle}" Text="设置"/><TextBlock Style="{StaticResource PageSubtitle}" Text="模型密钥写入 Windows Credential Locker；RAG 后端仅获得运行期副本，界面和日志均不回显。"/></StackPanel>
        <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="OpenAI 兼容模型"/>
            <TextBox Header="API 地址" Text="{Binding BaseUrl, Mode=TwoWay}"/>
            <TextBox Header="模型" Text="{Binding Model, Mode=TwoWay}"/>
            <PasswordBox x:Name="ApiKeyBox" Header="API Key" PasswordRevealMode="Peek"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="安全保存并注册" Click="Save_Click"/><Button Content="从凭据库恢复" Click="Restore_Click"/><Button Content="测试连接" Click="Test_Click"/><Button Content="取消" Click="Cancel_Click"/></StackPanel>
            <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" Text="{Binding Notice}"/>
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </StackPanel></Border>
        <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="6"><TextBlock FontWeight="SemiBold" Text="当前运行时状态"/><TextBlock Text="{Binding Status.Provider}"/><TextBlock Text="{Binding Status.Model}"/><TextBlock Text="{Binding Status.BaseUrl}"/><TextBlock Text="{Binding Status.Source}"/></StackPanel></Border>
        <InfoBar IsOpen="True" Severity="Informational" Title="数据边界" Message="客户端只连接 127.0.0.1:8765，不直接打开项目数据库；正式数据库与其 sidecar 由后端服务管理。"/>
        <ProgressRing Width="24" Height="24" HorizontalAlignment="Left" IsActive="{Binding IsBusy}"/>
    </StackPanel></ScrollViewer>
</Page>
