<Page x:Class="EvidenceRag.Windows.Pages.WikiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitle}" Text="Wiki"/><TextBlock Style="{StaticResource PageSubtitle}" Text="浏览由可核验证据编译的知识页；没有生成数据时保持空态，不注入演示内容。"/></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="按标题、路径或内容筛选" Text="{Binding SearchText, Mode=TwoWay}"/><Button Grid.Column="1" Content="搜索" Click="Search_Click"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4"><TextBlock Text="共"/><TextBlock Text="{Binding Total}"/><TextBlock Text="页"/></StackPanel></Grid>
        <ListView Grid.Row="2" ItemsSource="{Binding Pages}"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"><StackPanel Spacing="4"><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Opacity="0.65" IsTextSelectionEnabled="True" Text="{Binding LogicalPath}"/><TextBlock TextWrapping="Wrap" Text="{Binding Summary}"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding PageType}"/><TextBlock Text="{Binding Source}"/><TextBlock Text="{Binding Status}"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
        <Grid Grid.Row="3"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="上一页" IsEnabled="{Binding CanPrevious}" Click="Previous_Click"/><TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}"/><Button Content="下一页" IsEnabled="{Binding CanNext}" Click="Next_Click"/><ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}"/><TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding ErrorMessage}"/></StackPanel></Grid>
    </Grid>
</Page>
