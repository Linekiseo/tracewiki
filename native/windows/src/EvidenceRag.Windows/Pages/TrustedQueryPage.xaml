<Page x:Class="EvidenceRag.Windows.Pages.TrustedQueryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitle}" Text="可信查询" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="对代码、研发会话、研究工作区、实验、Notebook 与文档统一规划、检索和带证据回答。" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" PlaceholderText="输入需要证据支持的问题…" Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Spacing="8"><Button Content="开始可信查询" Click="Submit_Click"/><Button Content="取消" Click="Cancel_Click"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center" Text="代码仓库" />
                <ComboBox Width="360" ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}" DisplayMemberPath="DisplayName" PlaceholderText="选择唯一仓库以固定分支与提交" />
                <TextBlock VerticalAlignment="Center" Opacity="0.65" Text="跨来源查询仍使用同一受治理代码版本。" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <InfoBar IsOpen="True" Severity="Informational" Title="回答状态" Message="{Binding AnswerMode}" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="证据约束回答" />
                            <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="{Binding Answer}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="证据/引文" /><TextBlock Text="{Binding EvidenceCount}" />
                                <TextBlock Opacity="0.7" Text="{Binding InteractionId}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="查询历史" />
                <ListView Grid.Row="1" ItemsSource="{Binding History}">
                    <ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DisplayTitle}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Opacity="0.7" Text="{Binding AnswerMode}"/><TextBlock Opacity="0.7" Text="{Binding ReasonCode}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="证据"/><TextBlock Text="{Binding Evidence.Count}"/><TextBlock Opacity="0.65" Text="{Binding CreatedAt}"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="上一页" IsEnabled="{Binding CanPreviousHistoryPage}" Click="Previous_Click"/><TextBlock VerticalAlignment="Center" Text="{Binding HistoryPageLabel}"/><Button Content="下一页" IsEnabled="{Binding HasNextHistoryPage}" Click="Next_Click"/></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
