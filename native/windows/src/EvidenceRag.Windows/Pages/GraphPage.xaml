<Page x:Class="EvidenceRag.Windows.Pages.GraphPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitle}" Text="关系图谱"/><TextBlock Style="{StaticResource PageSubtitle}" Text="原生主从视图呈现节点与关系；图谱数据直接来自 /v1/graph。"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"><ComboBox Width="180" SelectedValue="{Binding Domain, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="overview"/><ComboBoxItem Content="code"/><ComboBoxItem Content="codex"/><ComboBoxItem Content="research"/><ComboBoxItem Content="document"/></ComboBox><Button Content="加载图谱" Click="Load_Click"/><TextBlock VerticalAlignment="Center" Text="节点"/><TextBlock VerticalAlignment="Center" Text="{Binding NodeCount}"/><TextBlock VerticalAlignment="Center" Text="关系"/><TextBlock VerticalAlignment="Center" Text="{Binding EdgeCount}"/><ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}"/><TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding ErrorMessage}"/></StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="节点"/><ListView Grid.Row="1" ItemsSource="{Binding Nodes}"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,8" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{Binding DisplayLabel}"/><TextBlock Opacity="0.65" Text="{Binding Id}"/><TextBlock Text="{Binding DisplayType}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="关系"/><ListView Grid.Row="1" ItemsSource="{Binding Edges}"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,8" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{Binding DisplayType}"/><TextBlock Opacity="0.7" Text="{Binding Source}"/><TextBlock Text="{Binding Target}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
        </Grid>
    </Grid>
</Page>
