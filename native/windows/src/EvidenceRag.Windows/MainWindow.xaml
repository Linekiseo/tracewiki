<Window
    x:Class="EvidenceRag.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Evidence Wiki + RAG">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Margin="48,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Evidence Wiki + RAG" />
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="项目" Tag="projects"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="可信查询" Tag="query"><NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Wiki" Tag="wiki"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="关系图谱" Tag="graph"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F0;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="研发会话" Tag="sessions"><NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="智能体" Tag="agents"><NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
