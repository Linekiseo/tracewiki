{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceWiki",
  "version": "0.1.0",
  "identifier": "com.evidencerag.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "TraceWiki · 循证知识工作台",
        "width": 1480,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Traceable Wiki and evidence-governed RAG workbench",
    "longDescription": "TraceWiki organizes code, sessions, experiments and documents into an evidence-governed Wiki with intelligent retrieval and agent control.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["evidence-rag"]
      }
    }
  }
}
